#!/bin/bash

user_agent="User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"
referer="Referer: http://www.hbr1.com/cgi-bin/main.php?module=listen"
stations_dir="stations"

hbr1_stations=("trance" "ambient" "tronic")

for station in ${hbr1_stations[@]}; do
  printf "\nDownloading station $station...\n"
  echo "http://www.hbr1.com/playlist/${station}.ogg.m3u" > "${stations_dir}/${station}.ogg.m3u"
  sleep 0.5 # seconds
done

# This radio is unavailable also in all other clients in web
printf "\nDownloading station Dubstep FM...\n"
echo http://dubstep.fm/listen.m3u > "${stations_dir}/dubstepfm.ogg.m3u"

printf "\nDownloading station Radio Funky...\n"
echo 'http://live.radiofunky.ro:8888' > "${stations_dir}/radiofunky.ogg.m3u"

printf "\nDownloading station Riviera Radio...\n"
echo 'https://media-ssl.musicradio.com/RivieraRadio' > "${stations_dir}/rivieraradio.ogg.m3u"